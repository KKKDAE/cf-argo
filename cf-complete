main() {
    ensure_dirs

    case "${1:-}" in
        --auto-test) auto_test; exit 0 ;;
        --auto-dns)  auto_dns; exit 0 ;;
    esac

    print_banner
    while true; do
        show_menu
        read -rp "请选择 [0-9]: " choice
        case "$choice" in
            1) install_cloudflared ;;
            2) setup_argo_tunnel ;;
            3) run_speed_test ;;
            4) update_cloudflare_dns ;;
            5) write_hosts_file ;;
            6) setup_argo_cname ;;
            7) install_proxy_core ;;
