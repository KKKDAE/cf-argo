#!/bin/bash
# ============================================================
# 全自动 Cloudflared + Argo 隧道 + 代理内核 部署脚本
# 版本: auto-v1.0
# 使用方式:
#   交互模式:   ./cf-auto.sh
#   自动模式:   CF_EMAIL=... CF_API_KEY=... DOMAIN=... ./cf-auto.sh --auto
# ============================================================
set -e

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'
print_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
print_ok()   { echo -e "${GREEN}[OK]${NC} $1"; }
print_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
print_err()  { echo -e "${RED}[ERR]${NC} $1"; }

CONFIG_DIR="$HOME/.cloudflare-config"
LOG_DIR="$CONFIG_DIR/logs"
mkdir -p "$CONFIG_DIR" "$LOG_DIR"

has_systemd() { [[ -d /run/systemd/system || $(ps --no-headers -o comm 1 2>/dev/null) == "systemd" ]]; }

# ---------- 安装依赖 ----------
install_deps() {
    local missing=()
    for cmd in curl wget tar python3; do
        command -v $cmd &>/dev/null || missing+=($cmd)
    done
    [[ ${#missing[@]} -eq 0 ]] && return
    print_info "安装依赖: ${missing[*]}"
    if command -v apt-get &>/dev/null; then
        apt-get update -qq && apt-get install -y ${missing[*]}
    elif command -v yum &>/dev/null; then
        yum install -y ${missing[*]}
    elif command -v apk &>/dev/null; then
        apk add ${missing[*]}
    else
        print_warn "请手动安装: ${missing[*]}"
    fi
}

# ---------- 安装 cloudflared ----------
install_cloudflared() {
    if command -v cloudflared &>/dev/null; then
        print_ok "cloudflared 已安装: $(cloudflared --version | head -1)"
        return
    fi
    local arch=$(uname -m)
    case $arch in x86_64|amd64) arch="amd64";; aarch64|arm64) arch="arm64";; armv7l) arch="arm";; *) print_err "不支持的架构"; exit 1;; esac
    local os=$(uname -s | tr '[:upper:]' '[:lower:]')
    local dl="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-${os}-${arch}"
    print_info "下载 cloudflared..."
    local tmp=$(mktemp)
    curl -fsSL -o "$tmp" "$dl" || { print_err "下载失败"; exit 1; }
    chmod +x "$tmp"
    mv "$tmp" /usr/local/bin/cloudflared 2>/dev/null || { mkdir -p ~/.local/bin; mv "$tmp" ~/.local/bin/cloudflared; export PATH="$HOME/.local/bin:$PATH"; }
    print_ok "cloudflared 安装完成"
}

# ---------- 安装代理内核 (Sing-box) ----------
install_singbox() {
    if command -v sing-box &>/dev/null; then
        print_ok "Sing-box 已安装: $(sing-box version 2>&1 | head -1)"
        return
    fi
    local arch=$(uname -m)
    case $arch in x86_64) arch="amd64";; aarch64) arch="arm64";; *) print_err "不支持的架构"; exit 1;; esac
    cd /tmp
    local ver=$(curl -s https://api.github.com/repos/SagerNet/sing-box/releases/latest | grep tag_name | cut -d '"' -f 4)
    local dl="https://github.com/SagerNet/sing-box/releases/download/${ver}/sing-box-${ver#v}-linux-${arch}.tar.gz"
    curl -L -o sb.tar.gz "$dl" || { print_err "下载失败"; exit 1; }
    tar -xzf sb.tar.gz
    mv sing-box-*/sing-box /usr/local/bin/
    chmod +x /usr/local/bin/sing-box
    rm -rf sing-box-* sb.tar.gz
    print_ok "Sing-box 安装完成"
}

# ---------- 生成随机配置 ----------
generate_random_config() {
    UUID=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen)
    PORT=8443
    WSPATH="/${UUID//-/}"
    PROTOCOL="vless"   # 默认VLESS
}

# ---------- 启动代理服务 ----------
start_proxy_service() {
    mkdir -p /etc/sing-box
    cat > /etc/sing-box/config.json <<EOF
{
  "log": {"level": "info"},
  "inbounds": [{
    "type": "vless",
    "listen": "127.0.0.1",
    "listen_port": ${PORT},
    "users": [{"uuid": "${UUID}"}],
    "transport": {"type": "ws", "path": "${WSPATH}"}
  }],
  "outbounds": [{"type": "direct"}]
}
EOF

    if has_systemd; then
        cat > /etc/systemd/system/sing-box.service <<SVC
[Unit]
Description=Sing-box
After=network.target
[Service]
Type=simple
ExecStart=/usr/local/bin/sing-box run -c /etc/sing-box/config.json
Restart=on-failure
[Install]
WantedBy=multi-user.target
SVC
        systemctl daemon-reload
        systemctl restart sing-box
        systemctl enable sing-box
        print_ok "Sing-box 已启动（systemd）"
    else
        pkill sing-box 2>/dev/null; sleep 1
        nohup /usr/local/bin/sing-box run -c /etc/sing-box/config.json > /var/log/sing-box.log 2>&1 &
        print_ok "Sing-box 已启动（nohup）"
    fi
}

# ---------- 配置 Cloudflared 隧道 ----------
setup_tunnel() {
    print_info "登录 Cloudflare..."
    cloudflared tunnel login --email "$CF_EMAIL" --api-key "$CF_API_KEY"

    print_info "创建隧道..."
    TUNNEL_NAME="auto-tunnel-$(date +%s)"
    cloudflared tunnel create "$TUNNEL_NAME"
    TUNNEL_ID=$(cloudflared tunnel list | grep "$TUNNEL_NAME" | awk '{print $1}')

    print_info "配置 DNS 路由: $DOMAIN -> $TUNNEL_ID"
    cloudflared tunnel route dns "$TUNNEL_ID" "$DOMAIN"

    CFG="$CONFIG_DIR/${TUNNEL_ID}.yml"
    cat > "$CFG" <<EOF
tunnel: ${TUNNEL_ID}
credentials-file: ${HOME}/.cloudflared/${TUNNEL_ID}.json
ingress:
  - hostname: ${DOMAIN}
    service: http://127.0.0.1:${PORT}
  - service: http_status:404
EOF

    # 保存信息
    cat > "$CONFIG_DIR/tunnel_info.txt" <<EOF
TUNNEL_ID=${TUNNEL_ID}
TUNNEL_NAME=${TUNNEL_NAME}
TUNNEL_DOMAIN=${DOMAIN}
LOCAL_SERVICE=http://127.0.0.1:${PORT}
CONFIG_FILE=${CFG}
EOF

    # 启动隧道
    pkill cloudflared 2>/dev/null; sleep 1
    nohup cloudflared tunnel --config "$CFG" run "$TUNNEL_ID" > /var/log/cloudflared.log 2>&1 &
    print_ok "隧道已启动"
}

# ---------- 生成客户端连接 ----------
generate_client_link() {
    local preferred_ip="${1:-}"
    [[ -z "$preferred_ip" ]] && preferred_ip="$DOMAIN"
    local encoded_path=$(python3 -c "import urllib.parse; print(urllib.parse.quote('${WSPATH}'))" 2>/dev/null || echo "$WSPATH")
    echo -e "\n${GREEN}========== VLESS 客户端链接 ==========${NC}"
    echo "vless://${UUID}@${preferred_ip}:${PORT}?encryption=none&security=tls&sni=${DOMAIN}&type=ws&host=${DOMAIN}&path=${encoded_path}#Auto-${DOMAIN}"
    echo -e "\n${YELLOW}若需优选 IP，请将地址替换为实测最快的 Cloudflare IP。${NC}"
}

# ---------- 全自动部署 ----------
auto_deploy() {
    # 检查必要环境变量
    if [[ -z "$CF_EMAIL" || -z "$CF_API_KEY" ]]; then
        print_err "请设置环境变量: CF_EMAIL 和 CF_API_KEY"
        exit 1
    fi
    if [[ -z "$DOMAIN" ]]; then
        print_err "请设置环境变量: DOMAIN (例如: myapp.example.com)"
        exit 1
    fi

    print_banner() {
        echo -e "${CYAN}全自动部署模式${NC}"
    }
    print_banner

    install_deps
    install_cloudflared
    install_singbox
    generate_random_config
    start_proxy_service
    setup_tunnel
    generate_client_link "$PREFERRED_IP"

    # 保存代理信息
    cat > "$CONFIG_DIR/proxy_info.txt" <<EOF
协议=vless
端口=${PORT}
UUID=${UUID}
WebSocket 路径=${WSPATH}
EOF

    print_ok "全自动部署完成！"
    echo -e "\n${GREEN}============================================${NC}"
    echo -e "隧道域名: ${DOMAIN}"
    echo -e "本地代理端口: ${PORT}"
    echo -e "UUID: ${UUID}"
    echo -e "WebSocket 路径: ${WSPATH}"
    echo -e "\n请将上面的 VLESS 链接导入客户端使用。"
    echo -e "如需修改配置，请运行: cf-manager (稍后安装)"
    echo -e "${GREEN}============================================${NC}"
}

# ---------- 交互式菜单 ----------
interactive_menu() {
    print_info "交互式管理模式，请使用之前的 cf-manager 脚本。"
    print_info "若要全自动部署，请退出并使用 --auto 参数。"
    exit 0
}

# ---------- 主入口 ----------
case "${1:-}" in
    --auto|auto)
        auto_deploy
        ;;
    *)
        interactive_menu
        ;;
esac
