#!/bin/bash
# ============================================================
# Cloudflared + Argo 隧道 + 代理内核 全功能管理脚本
# 功能：
#   1. 安装/更新 cloudflared
#   2. 配置 Argo 隧道 (支持 Email + Global API Key 认证)
#   3. Cloudflare DNS 更新（A 记录）
#   4. 写入 /etc/hosts
#   5. Argo 隧道 + CNAME 优选路由
#   6. 安装代理内核（Xray / Sing-box）并自动对接隧道
#   7. 设置定时自动优选
#   8. 查看系统状态
#   9. 生成 V2Ray 客户端连接 (基于优选 IP)
# 特点：完全交互式，配置持久化，支持非交互模式用于 cron
# ============================================================

set -e

# ---------- 颜色定义 ----------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# ---------- 配置变量 ----------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$SCRIPT_DIR/.cloudflare-config"
LOG_DIR="$CONFIG_DIR/logs"
CF_API_URL="https://api.cloudflare.com/client/v4"
MAX_RETRIES=5
RETRY_DELAY=2

# ---------- 工具函数 ----------
print_banner() {
    echo -e "${CYAN}"
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║   Cloudflared + Argo 隧道 + 代理内核 管理工具               ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}
print_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
print_ok()   { echo -e "${GREEN}[OK]${NC} $1"; }
print_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
print_err()  { echo -e "${RED}[ERR]${NC} $1"; }

require_cmd() {
    if ! command -v "$1" &>/dev/null; then
        print_err "缺少命令: $1，请先安装"
        return 1
    fi
    return 0
}

ensure_dirs() {
    mkdir -p "$CONFIG_DIR" "$LOG_DIR"
}

# ---------- API 请求重试函数 ----------
curl_with_retry() {
    local method="$1"
    local url="$2"
    local headers=()
    local data=""
    local retry_count=0
    local max_retries=$MAX_RETRIES
    local delay=$RETRY_DELAY

    # 解析 headers 和 data
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -H) headers+=("$2"); shift 2 ;;
            -d) data="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    while (( retry_count < max_retries )); do
        print_info "API 请求 (尝试 $((retry_count + 1))/$max_retries)..."
        
        local cmd="curl -fsSL -X $method '$url'"
        for header in "${headers[@]}"; do
            cmd="$cmd -H '$header'"
        done
        if [[ -n "$data" ]]; then
            cmd="$cmd -d '$data'"
        fi
        
        local response=$(eval "$cmd" 2>/dev/null)
        
        # 检查响应是否成功
        if echo "$response" | grep -q '"success":true'; then
            echo "$response"
            return 0
        fi
        
        # 检查是否有错误信息
        if echo "$response" | grep -q '"success":false'; then
            local error_msg=$(echo "$response" | grep -oP '"message":"[^"]+"' | head -1 | cut -d'"' -f4)
            print_warn "API 返回错误: ${error_msg:-未知错误}"
        fi
        
        ((retry_count++))
        if (( retry_count < max_retries )); then
            print_warn "等待 ${delay} 秒后重试..."
            sleep "$delay"
        fi
    done
    
    print_err "API 请求失败，已尝试 $max_retries 次"
    return 1
}

# ---------- 1. 安装 cloudflared ----------
install_cloudflared() {
    echo -e "\n${CYAN}========== 安装 cloudflared ==========${NC}"
    if command -v cloudflared &>/dev/null; then
        local ver=$(cloudflared --version 2>/dev/null | head -1)
        print_ok "cloudflared 已安装: $ver"
        read -rp "是否重新安装/更新? [y/N]: " confirm
        [[ "$confirm" =~ ^[Yy]$ ]] || return 0
    fi

    local arch=$(uname -m)
    local os=$(uname -s | tr '[:upper:]' '[:lower:]')
    local download_url=""

    case "$arch" in
        x86_64|amd64)  arch="amd64" ;;
        aarch64|arm64) arch="arm64" ;;
        armv7l|armv7)  arch="arm" ;;
        i386|i686)     arch="386" ;;
        *) print_err "不支持的架构: $arch"; return 1 ;;
    esac

    case "$os" in
        linux)   download_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${arch}" ;;
        darwin)  download_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-darwin-${arch}" ;;
        *) print_err "不支持的操作系统: $os"; return 1 ;;
    esac

    print_info "正在下载: $download_url"
    local tmpfile=$(mktemp)
    if command -v curl &>/dev/null; then
        curl -fsSL -o "$tmpfile" "$download_url" || { print_err "下载失败"; rm -f "$tmpfile"; return 1; }
    elif command -v wget &>/dev/null; then
        wget -q -O "$tmpfile" "$download_url" || { print_err "下载失败"; rm -f "$tmpfile"; return 1; }
    else
        print_err "需要 curl 或 wget"
        return 1
    fi

    chmod +x "$tmpfile"
    if [[ "$os" == "linux" ]]; then
        sudo mv "$tmpfile" /usr/local/bin/cloudflared 2>/dev/null || {
            print_warn "无法写入 /usr/local/bin，尝试写入 ~/.local/bin"
            mkdir -p ~/.local/bin
            mv "$tmpfile" ~/.local/bin/cloudflared
            export PATH="$HOME/.local/bin:$PATH"
            echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc
        }
    else
        sudo mv "$tmpfile" /usr/local/bin/cloudflared 2>/dev/null || mv "$tmpfile" /usr/local/bin/cloudflared
    fi

    print_ok "cloudflared 安装完成"
    cloudflared --version
}

# ---------- 2. Argo 隧道配置 (支持 Email + Global API Key) ----------
setup_argo_tunnel() {
    echo -e "\n${CYAN}========== 配置 Argo 隧道 ==========${NC}"
    require_cmd cloudflared || return 1

    # ----- 步骤 1: 登录 Cloudflare 认证 -----
    print_info "步骤 1: 登录 Cloudflare 认证"
    local auth_type=""
    if [[ -f "$HOME/.cloudflared/cert.pem" ]]; then
        print_ok "已检测到认证文件"
        read -rp "是否重新认证? [y/N]: " reauth
        [[ ! "$reauth" =~ ^[Yy]$ ]] && auth_type="skip"
    fi

    if [[ "$auth_type" != "skip" ]]; then
        echo "选择认证方式:"
        echo "1) 浏览器认证 (默认)"
        echo "2) Email + Global API Key"
        read -rp "请选择 [1-2]: " auth_choice
        case "$auth_choice" in
            2)
                read -rp "输入 Cloudflare 注册邮箱: " cf_email
                read -rsp "输入 Global API Key: " cf_apikey; echo
                if [[ -z "$cf_email" || -z "$cf_apikey" ]]; then
                    print_err "邮箱和 API Key 不能为空"; return 1
                fi
                print_info "使用 API Key 认证..."
                cloudflared tunnel login --email "$cf_email" --api-key "$cf_apikey"
                ;;
            *)
                print_info "使用浏览器认证..."
                cloudflared tunnel login
                ;;
        esac
    fi

    # ----- 步骤 2: 创建/选择隧道 -----
    print_info "步骤 2: 创建/选择隧道"
    echo "1) 创建新隧道"
    echo "2) 列出已有隧道"
    echo "3) 使用已有隧道"
    read -rp "请选择 [1-3]: " tunnel_choice

    local tunnel_id=""
    local tunnel_name=""

    case "$tunnel_choice" in
        1)
            read -rp "输入隧道名称 (如: my-tunnel): " tunnel_name
            [[ -z "$tunnel_name" ]] && { print_err "名称不能为空"; return 1; }
            print_info "正在创建隧道: $tunnel_name"
            cloudflared tunnel create "$tunnel_name"
            tunnel_id=$(cloudflared tunnel list | grep "$tunnel_name" | awk '{print $1}')
            print_ok "隧道创建成功，ID: $tunnel_id"
            ;;
        2)
            print_info "已有隧道列表:"
            cloudflared tunnel list
            read -rp "输入要使用的隧道 ID: " tunnel_id
            ;;
        3)
            read -rp "输入隧道 ID: " tunnel_id
            ;;
        *)
            print_err "无效选择"
            return 1
            ;;
    esac

    [[ -z "$tunnel_id" ]] && { print_err "隧道 ID 无效"; return 1; }

    # ----- 步骤 3: 配置隧道路由 -----
    print_info "步骤 3: 配置隧道路由"
    read -rp "输入要代理的本地服务地址 (默认: http://localhost:8080): " local_service
    [[ -z "$local_service" ]] && local_service="http://localhost:8080"
    
    read -rp "输入要绑定的域名 (如: tunnel.example.com): " tunnel_domain
    [[ -z "$tunnel_domain" ]] && { print_err "域名不能为空"; return 1; }

    local config_file="$CONFIG_DIR/${tunnel_id}.yml"
    cat > "$config_file" <<EOF
tunnel: ${tunnel_id}
credentials-file: ${HOME}/.cloudflared/${tunnel_id}.json

ingress:
  - hostname: ${tunnel_domain}
    service: ${local_service}
  - service: http_status:404
EOF

    print_info "配置文件已保存: $config_file"
    cat "$config_file"

    # ----- 步骤 4: 配置 DNS 路由 -----
    print_info "步骤 4: 配置 DNS 路由"
    cloudflared tunnel route dns "$tunnel_id" "$tunnel_domain"
    print_ok "DNS 路由已配置: $tunnel_domain -> $tunnel_id"

    cat > "$CONFIG_DIR/tunnel_info.txt" <<EOF
TUNNEL_ID=${tunnel_id}
TUNNEL_NAME=${tunnel_name:-unknown}
TUNNEL_DOMAIN=${tunnel_domain}
LOCAL_SERVICE=${local_service}
CONFIG_FILE=${config_file}
EOF

    # ----- 步骤 5: 启动隧道测试 -----
    print_info "步骤 5: 启动隧道测试"
    read -rp "是否立即启动隧道测试? [Y/n]: " start_now
    if [[ ! "$start_now" =~ ^[Nn]$ ]]; then
        print_info "正在启动隧道 (按 Ctrl+C 停止)..."
        cloudflared tunnel --config "$config_file" run "$tunnel_id"
    fi

    print_ok "Argo 隧道配置完成!"
    print_info "后续启动命令: cloudflared tunnel --config $config_file run $tunnel_id"
    print_info "或后台运行: nohup cloudflared tunnel --config $config_file run $tunnel_id &"
}

# ---------- 3. DNS 更新（带重试机制）----------
update_cloudflare_dns() {
    echo -e "\n${CYAN}========== Cloudflare DNS 更新 ==========${NC}"
    require_cmd curl || return 1

    read -rp "输入要设置的 IP 地址: " ip
    [[ -z "$ip" ]] && { print_err "IP 不能为空"; return 1; }

    local api_token="" api_key="" email="" zone_id="" record_name=""
    local cred_file="$CONFIG_DIR/cf_credentials.conf"
    
    if [[ -f "$cred_file" ]]; then
        source "$cred_file"
        print_ok "已加载保存的 API 凭证"
        read -rp "是否使用已有凭证? [Y/n]: " use_saved
        [[ "$use_saved" =~ ^[Nn]$ ]] && { api_token=""; api_key=""; email=""; zone_id=""; record_name=""; }
    fi

    # API 凭证输入重试循环
    local auth_retry=0
    while (( auth_retry < MAX_RETRIES )); do
        if [[ -z "$api_token" && -z "$api_key" ]]; then
            echo "1) API Token (推荐)"
            echo "2) Global API Key + Email"
            read -rp "请选择 [1-2]: " auth_type
            case "$auth_type" in
                1) read -rsp "输入 API Token: " api_token; echo ;;
                2) read -rp "输入 Email: " email; read -rsp "输入 Global API Key: " api_key; echo ;;
                *) print_err "无效选择"; return 1 ;;
            esac
            read -rp "输入 Zone ID: " zone_id
            read -rp "输入要更新的域名记录 (如: www.example.com): " record_name
        fi

        [[ -z "$zone_id" || -z "$record_name" ]] && { print_err "Zone ID 或记录名缺失"; return 1; }

        local auth_header=""
        if [[ -n "$api_token" ]]; then
            auth_header="Authorization: Bearer ${api_token}"
        else
            auth_header="X-Auth-Key: ${api_key}"
        fi

        # 测试 API 连接
        print_info "验证 API 凭证 (尝试 $((auth_retry + 1))/$MAX_RETRIES)..."
        local test_response=$(curl -fsSL -X GET "${CF_API_URL}/zones/${zone_id}" \
            -H "Content-Type: application/json" \
            -H "$auth_header" \
            ${email:+-H "X-Auth-Email: ${email}"} 2>/dev/null || echo '{"success":false}')
        
        if echo "$test_response" | grep -q '"success":true'; then
            print_ok "API 凭证验证成功"
            break
        else
            print_warn "API 凭证验证失败，请重新输入"
            api_token="" api_key="" email="" zone_id="" record_name=""
            ((auth_retry++))
            if (( auth_retry < MAX_RETRIES )); then
                print_info "等待 ${RETRY_DELAY} 秒后重试..."
                sleep "$RETRY_DELAY"
            fi
        fi
    done

    if (( auth_retry >= MAX_RETRIES )); then
        print_err "API 凭证验证失败，已尝试 $MAX_RETRIES 次，返回主菜单"
        return 1
    fi

    # 保存凭证
    cat > "$cred_file" <<EOF
API_TOKEN=${api_token}
API_KEY=${api_key}
EMAIL=${email}
ZONE_ID=${zone_id}
RECORD_NAME=${record_name}
EOF
    chmod 600 "$cred_file"
    print_ok "凭证已保存"

    # 获取现有 DNS 记录
    local list_url="${CF_API_URL}/zones/${zone_id}/dns_records?type=A&name=${record_name}"
    local list_response=$(curl_with_retry "GET" "$list_url" \
        -H "Content-Type: application/json" \
        -H "$auth_header" \
        ${email:+-H "X-Auth-Email: ${email}"}) || return 1
    
    local record_id=$(echo "$list_response" | grep -oP '"id":"[^"]+"' | head -1 | cut -d'"' -f4)

    local payload="{\"type\":\"A\",\"name\":\"${record_name}\",\"content\":\"${ip}\",\"ttl\":120,\"proxied\":false}"
    
    if [[ -n "$record_id" ]]; then
        print_info "更新现有 A 记录"
        curl_with_retry "PUT" "${CF_API_URL}/zones/${zone_id}/dns_records/${record_id}" \
            -H "Content-Type: application/json" \
            -H "$auth_header" \
            ${email:+-H "X-Auth-Email: ${email}"} \
            -d "$payload" > /dev/null || return 1
    else
        print_info "创建新 A 记录"
        curl_with_retry "POST" "${CF_API_URL}/zones/${zone_id}/dns_records" \
            -H "Content-Type: application/json" \
            -H "$auth_header" \
            ${email:+-H "X-Auth-Email: ${email}"} \
            -d "$payload" > /dev/null || return 1
    fi
    
    print_ok "DNS 记录更新成功: ${record_name} -> ${ip}"
    echo "$(date) - ${record_name} -> ${ip}" >> "$LOG_DIR/dns_updates.log"
}

# ---------- 4. hosts 写入 ----------
write_hosts_file() {
    local ip=${1:-""}
    local domain=${2:-""}
    echo -e "\n${CYAN}========== 写入 /etc/hosts ==========${NC}"
    if [[ -z "$ip" ]]; then
        read -rp "输入 IP 地址: " ip
    fi
    [[ -z "$ip" ]] && { print_err "IP 不能为空"; return 1; }
    if [[ -z "$domain" ]]; then
        read -rp "输入要绑定的域名: " domain
    fi
    [[ -z "$domain" ]] && domain="your-domain.com"

    local hosts_entry="${ip} ${domain} # CF-optimized-$(date +%s)"
    sudo cp /etc/hosts /etc/hosts.bak.$(date +%s) 2>/dev/null || true
    sudo sed -i "/${domain}.*# CF-optimized/d" /etc/hosts 2>/dev/null || true
    echo "$hosts_entry" | sudo tee -a /etc/hosts > /dev/null
    print_ok "已写入 /etc/hosts: ${ip} ${domain}"
}

# ---------- 5. Argo 隧道 + CNAME 优选路由 ----------
setup_argo_cname() {
    echo -e "\n${CYAN}========== Argo 隧道 + CNAME 优选路由 ==========${NC}"
    require_cmd cloudflared || return 1

    local tunnel_info="$CONFIG_DIR/tunnel_info.txt"
    if [[ ! -f "$tunnel_info" ]]; then
        print_err "请先配置 Argo 隧道 (选项 2)"
        return 1
    fi
    source "$tunnel_info"

    print_warn "请手动输入优选 IP"
    read -rp "输入优选 IP: " best_ip
    [[ -z "$best_ip" ]] && { print_err "缺少优选 IP"; return 1; }

    print_info "配置本地 hosts 指向优选 IP: ${best_ip}"
    read -rp "是否在本地 hosts 中将 ${TUNNEL_DOMAIN} 指向 ${best_ip}? [Y/n]: " set_local
    if [[ ! "$set_local" =~ ^[Nn]$ ]]; then
        write_hosts_file "$best_ip" "$TUNNEL_DOMAIN"
    fi

    print_info "配置 DNS CNAME 记录指向 Argo 隧道"
    local cname_target="${TUNNEL_ID}.cfargotunnel.com"
    read -rp "输入要创建 CNAME 的域名 (如: argo.example.com): " cname_domain
    [[ -z "$cname_domain" ]] && { print_err "域名不能为空"; return 1; }

    local cred_file="$CONFIG_DIR/cf_credentials.conf"
    if [[ ! -f "$cred_file" ]]; then
        print_err "请先配置 Cloudflare API 凭证 (选项 3)"
        return 1
    fi
    source "$cred_file"
    [[ -z "$zone_id" ]] && { print_err "Zone ID 未配置"; return 1; }

    local auth_header=""
    if [[ -n "$api_token" ]]; then
        auth_header="Authorization: Bearer ${api_token}"
    else
        auth_header="X-Auth-Key: ${api_key}"
    fi

    local payload="{\"type\":\"CNAME\",\"name\":\"${cname_domain}\",\"content\":\"${cname_target}\",\"ttl\":120,\"proxied\":true}"
    local list_url="${CF_API_URL}/zones/${zone_id}/dns_records?type=CNAME&name=${cname_domain}"
    local list_response=$(curl_with_retry "GET" "$list_url" \
        -H "Content-Type: application/json" \
        -H "$auth_header" \
        ${email:+-H "X-Auth-Email: ${email}"}) || return 1
    
    local record_id=$(echo "$list_response" | grep -oP '"id":"[^"]+"' | head -1 | cut -d'"' -f4)

    if [[ -n "$record_id" ]]; then
        curl_with_retry "PUT" "${CF_API_URL}/zones/${zone_id}/dns_records/${record_id}" \
            -H "Content-Type: application/json" \
            -H "$auth_header" \
            ${email:+-H "X-Auth-Email: ${email}"} \
            -d "$payload" > /dev/null || return 1
    else
        curl_with_retry "POST" "${CF_API_URL}/zones/${zone_id}/dns_records" \
            -H "Content-Type: application/json" \
            -H "$auth_header" \
            ${email:+-H "X-Auth-Email: ${email}"} \
            -d "$payload" > /dev/null || return 1
    fi
    
    print_ok "CNAME 配置完成: ${cname_domain} -> ${cname_target}"
    echo "CNAME_DOMAIN=${cname_domain}" >> "$CONFIG_DIR/argo_cname.conf"
}

# ---------- 6. 安装代理内核（Xray / Sing-box）并自动对接隧道 ----------
install_proxy_core() {
    echo -e "\n${CYAN}========== 安装代理内核 ==========${NC}"
    echo "1) Xray (VLESS/VMess + WebSocket)"
    echo "2) Sing-box (轻量级，支持多种协议)"
    read -rp "请选择 [1-2]: " core_choice

    local core_type="" protocol_type=""
    case "$core_choice" in
        1) core_type="xray" ;;
        2) core_type="singbox" ;;
        *) print_err "无效选择"; return 1 ;;
    esac

    echo "选择协议:"
    echo "1) VLESS + WebSocket (推荐)"
    echo "2) VMess + WebSocket (兼容性好)"
    read -rp "请选择 [1-2]: " proto_choice
    case "$proto_choice" in
        1) protocol_type="vless" ;;
        2) protocol_type="vmess" ;;
        *) print_err "无效选择"; return 1 ;;
    esac

    local uuid=$(cat /proc/sys/kernel/random/uuid)
    local port=8443
    local ws_path="/${uuid//-/}"
    print_info "生成的 UUID: ${uuid}"
    print_info "WebSocket 路径: ${ws_path}"

    if [[ "$core_type" == "xray" ]]; then
        print_info "安装 Xray..."
        bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install
        mkdir -p /usr/local/etc/xray
        if [[ "$protocol_type" == "vless" ]]; then
            cat > /usr/local/etc/xray/config.json <<EOF
{
  "log": { "loglevel": "info" },
  "inbounds": [{
    "listen": "127.0.0.1",
    "port": ${port},
    "protocol": "vless",
    "settings": {
      "clients": [ { "id": "${uuid}", "flow": "" } ],
      "decryption": "none"
    },
    "streamSettings": {
      "network": "ws",
      "wsSettings": { "path": "${ws_path}" }
    }
  }],
  "outbounds": [ { "protocol": "freedom" } ]
}
EOF
        else
            cat > /usr/local/etc/xray/config.json <<EOF
{
  "log": { "loglevel": "info" },
  "inbounds": [{
    "listen": "127.0.0.1",
    "port": ${port},
    "protocol": "vmess",
    "settings": {
      "clients": [ { "id": "${uuid}" } ]
    },
    "streamSettings": {
      "network": "ws",
      "wsSettings": { "path": "${ws_path}" }
    }
  }],
  "outbounds": [ { "protocol": "freedom" } ]
}
EOF
        fi
        systemctl restart xray
        systemctl enable xray
    elif [[ "$core_type" == "singbox" ]]; then
        print_info "安装 Sing-box..."
        bash -c "$(curl -fsSL https://raw.githubusercontent.com/chise0713/sing-box-installer/master/sing-box-installer.sh)"
        mkdir -p /etc/sing-box
        cat > /etc/sing-box/config.json <<EOF
{
  "log": { "level": "info" },
  "inbounds": [{
    "type": "${protocol_type}",
    "listen": "127.0.0.1",
    "listen_port": ${port},
    "users": [ { "uuid": "${uuid}", "name": "default" } ],
    "transport": { "type": "ws", "path": "${ws_path}" }
  }],
  "outbounds": [ { "type": "direct" } ]
}
EOF
        systemctl restart sing-box
        systemctl enable sing-box
    fi

    print_ok "${core_type} 安装完成，代理监听在 127.0.0.1:${port}"
    cat > "$CONFIG_DIR/proxy_info.txt" <<EOF
代理类型: ${core_type}
协议: ${protocol_type}
端口: ${port}
UUID: ${uuid}
WebSocket 路径: ${ws_path}
EOF
    cat "$CONFIG_DIR/proxy_info.txt"

    # 自动对接现有隧道
    if [[ -f "$CONFIG_DIR/tunnel_info.txt" ]]; then
        read -rp "检测到已有 Argo 隧道，是否将隧道本地服务地址修改为 http://127.0.0.1:${port} ？[Y/n]: " modify_tunnel
        if [[ ! "$modify_tunnel" =~ ^[Nn]$ ]]; then
            source "$CONFIG_DIR/tunnel_info.txt"
            local config_file="$CONFIG_DIR/${TUNNEL_ID}.yml"
            if [[ -f "$config_file" ]]; then
                sed -i "s|service: .*|service: http://127.0.0.1:${port}|" "$config_file"
                print_ok "隧道配置已更新，本地服务指向代理端口 ${port}"
                systemctl restart cloudflared-${TUNNEL_NAME} 2>/dev/null || {
                    print_warn "未找到 systemd 服务，请手动重启隧道"
                }
            fi
        fi
    else
        print_warn "未检测到 Argo 隧道，请先配置隧道 (选项 2) 后再将本地服务指向 ${port}"
    fi
}

# ---------- 7. 定时自动优选 ----------
setup_cron() {
    echo -e "\n${CYAN}========== 定时自动 DNS 更新 ==========${NC}"
    read -rp "执行间隔 (小时，默认 6): " interval
    [[ -z "$interval" ]] && interval=6
    local script_path="${SCRIPT_DIR}/$(basename "$0")"
    local auto_script="$CONFIG_DIR/auto_optimize.sh"
    cat > "$auto_script" <<EOF
#!/bin/bash
export PATH=/usr/local/bin:/usr/bin:/bin
# 这里可以添加自动 DNS 更新的逻辑
EOF
    chmod +x "$auto_script"
    (crontab -l 2>/dev/null | grep -v "$auto_script"; echo "0 */${interval} * * * $auto_script") | crontab -
    print_ok "定时任务已设置，每 ${interval} 小时执行一次"
}

# ---------- 8. 查看状态 ----------
show_status() {
    echo -e "\n${CYAN}========== 系统状态 ==========${NC}"
    echo -e "\n${YELLOW}[cloudflared]${NC}"
    command -v cloudflared &>/dev/null && cloudflared --version || echo "未安装"
    echo -e "\n${YELLOW}[隧道配置]${NC}"
    [[ -f "$CONFIG_DIR/tunnel_info.txt" ]] && cat "$CONFIG_DIR/tunnel_info.txt" || echo "未配置"
    echo -e "\n${YELLOW}[API 凭证]${NC}"
    [[ -f "$CONFIG_DIR/cf_credentials.conf" ]] && echo "已配置" || echo "未配置"
    echo -e "\n${YELLOW}[代理内核]${NC}"
    if [[ -f "$CONFIG_DIR/proxy_info.txt" ]]; then
        cat "$CONFIG_DIR/proxy_info.txt"
    else
        echo "未安装"
    fi
    echo -e "\n${YELLOW}[定时任务]${NC}"
    crontab -l 2>/dev/null | grep -i "auto_optimize" || echo "未设置"
}

# ---------- 9. 生成 V2Ray 客户端连接 ----------
generate_v2ray_link() {
    echo -e "\n${CYAN}========== 生成 V2Ray 客户端连接 ==========${NC}"

    # 检查必要配置
    if [[ ! -f "$CONFIG_DIR/proxy_info.txt" ]]; then
        print_err "未找到代理内核配置，请先执行选项 6 安装代理内核"
        return 1
    fi
    if [[ ! -f "$CONFIG_DIR/tunnel_info.txt" ]]; then
        print_err "未找到 Argo 隧道配置，请先执行选项 2 配置隧道"
        return 1
    fi

    # 读取配置
    source "$CONFIG_DIR/proxy_info.txt"
    # 变量: 协议, 端口, UUID, WebSocket 路径 (格式: 协议: vless/vmess, 端口: ...)
    local proto=$(echo "$协议" | tr '[:upper:]' '[:lower:]')
    local port="$端口"
    local uuid="$UUID"
    local path="$WebSocket 路径"
    local domain=""

    # 获取域名（优先使用隧道域名，也可以自定义）
    source "$CONFIG_DIR/tunnel_info.txt"
    domain="${TUNNEL_DOMAIN}"
    echo "当前隧道域名: ${domain}"
    read -rp "是否使用此域名作为服务器地址? [Y/n]: " use_default_domain
    if [[ "$use_default_domain" =~ ^[Nn]$ ]]; then
        read -rp "请输入自定义域名: " domain
    fi
    [[ -z "$domain" ]] && { print_err "域名不能为空"; return 1; }

    # 获取优选 IP
    local best_ip=""
    read -rp "输入优选 IP (如 1.2.3.4): " best_ip
    [[ -z "$best_ip" ]] && { print_err "优选 IP 不能为空"; return 1; }

    # 可选：备注名称
    read -rp "输入备注名称 (可选): " remark
    [[ -z "$remark" ]] && remark="${domain}-优选"

    echo -e "\n${GREEN}========== 生成的客户端连接信息 ==========${NC}"
    echo -e "${CYAN}服务器地址: ${best_ip}  (实际连接地址)${NC}"
    echo -e "${CYAN}域名 (SNI/host): ${domain}${NC}"
    echo -e "${CYAN}端口: ${port}${NC}"
    echo -e "${CYAN}UUID: ${uuid}${NC}"
    echo -e "${CYAN}传输协议: ws${NC}"
    echo -e "${CYAN}路径: ${path}${NC}"
    echo -e "${CYAN}安全: tls${NC}"
    echo ""

    if [[ "$proto" == "vmess" ]]; then
        # 生成 vmess:// 链接 (base64编码的JSON)
        local vmess_json=$(cat <<EOF
{
  "v": "2",
  "ps": "${remark}",
  "add": "${best_ip}",
  "port": "${port}",
  "id": "${uuid}",
  "aid": "0",
  "net": "ws",
  "type": "none",
  "host": "${domain}",
  "path": "${path}",
  "tls": "tls"
}
EOF
)
        local vmess_base64=$(echo -n "$vmess_json" | base64 -w 0)
        echo -e "${GREEN}VMess 链接:${NC}"
        echo "vmess://${vmess_base64}"
        echo ""
        echo -e "${YELLOW}提示：导入客户端时，请手动修改地址为 ${best_ip}，并设置 SNI 为 ${domain}${NC}"
    elif [[ "$proto" == "vless" ]]; then
        # 生成 vless:// 链接
        local vless_url="vless://${uuid}@${best_ip}:${port}?encryption=none&security=tls&sni=${domain}&type=ws&host=${domain}&path=${encode_path}${path}#${remark}"
        # 注意: path 需要 URL 编码
        local encoded_path=$(python3 -c "import urllib.parse; print(urllib.parse.quote('${path}'))" 2>/dev/null || echo "${path}")
        vless_url="vless://${uuid}@${best_ip}:${port}?encryption=none&security=tls&sni=${domain}&type=ws&host=${domain}&path=${encoded_path}#${remark}"
        echo -e "${GREEN}VLESS 链接:${NC}"
        echo "${vless_url}"
        echo ""
    else
        print_err "不支持的协议: $proto"
        return 1
    fi

    # 输出通用客户端配置提示
    echo -e "${YELLOW}======================================${NC}"
    echo -e "客户端配置提示 (通用):"
    echo -e "地址(address): ${best_ip}"
    echo -e "端口(port): ${port}"
    echo -e "用户ID(id): ${uuid}"
    echo -e "传输协议(network): ws"
    echo -e "WebSocket路径(path): ${path}"
    echo -e "TLS: 开启"
    echo -e "SNI/host: ${domain}"
    echo -e "======================================"

    # 可选：自动写入 hosts 或更新 DNS？
    read -rp "是否将 ${domain} 在本地 hosts 中指向 ${best_ip}? [y/N]: " write_hosts
    if [[ "$write_hosts" =~ ^[Yy]$ ]]; then
        write_hosts_file "$best_ip" "$domain"
    fi
}

